        "destination": "/meta/llms.txt"
      },
      {
        "source": "/ai-catalog.json",
        "destination": "/meta/ai-catalog.json"
      },
      {
        "source": "/.well-known/ai-catalog.json",
        "destination": "/meta/.well-known/ai-catalog.json"
