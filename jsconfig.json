{
  "compilerOptions": {
    "paths": {
      "@/*": ["./shared/src/*"],
      "@tests/*": ["./shared/tests/*"],
      "@core": ["./core/index.ts"],
      "@core/*": ["./core/*"],
      "@website/*": ["./website/*"],
      "@cms/*": ["./cms/*"],
      "@earth/*": ["./experiments/earth-playground/*"],
      "@docs/*": ["./experiments/docs/*"]
    },
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false
  },
  "exclude": ["node_modules", "dist"]
}
