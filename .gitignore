.DS_Store
node_modules

# Workspaces: the root yarn.lock is the sole lockfile — per-module installs
# are hoisted to the root, so stray module lockfiles must never be committed.
**/yarn.lock
!/yarn.lock

# Test/audit artifacts — each module publishes reports/coverage locally.
# (anchored: tests/coverage/ dirs hold real tail tests and must be tracked)
/coverage/
**/reports/
.lighthouseci/
lighthouse-reports/


# local env files
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
.firebase/logs/

# Editor directories and files
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Local headless Chrome used for Lighthouse audits (not part of the repo)
chrome-headless-shell/

# Per-module Vite library builds — verification artifacts, never published.
core/dist/
website/dist/
cms/dist/
experiments/earth-playground/dist/
experiments/docs/dist/
