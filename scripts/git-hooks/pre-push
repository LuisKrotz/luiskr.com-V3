#!/usr/bin/env zsh
# luiskr.com pre-push gate — runs the full Jest suite in parallel without
# coverage instrumentation. Coverage and all other quality gates run in
# prebuild, while Lighthouse is opt-in after build via --verify-lighthouse.
#
# Installed by scripts/install-hooks.sh → .git/hooks/pre-push

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "── pre-push: Jest test suite (parallel, no coverage) ──"
yarn test

