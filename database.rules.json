{
  "rules": {
    "admin": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'luis.krotz@gmail.com'"
    },
    "translations": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'luis.krotz@gmail.com' || auth.token.email_verified === true)"
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
