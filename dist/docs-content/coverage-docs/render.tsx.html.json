navigate; files navigate). Children render inside a\n * nested &lt;ul&gt; only while the dir is in the host's open-set — per the\n * self-similar recursion rule the tree walks itself.\n */\nconst treeNodes = (view: ViewDocs, nodes: DocsNode[]): HTMLElement[] =&gt;\n  nodes.map((node) =&gt; {\n    const open = view.isDirOpen(node.path)\n&nbsp;\n    const active = view.docsPath === node.path\n&nbsp;\n    const isDir = node.type === 'dir'<span class=\"branch-0 cbranch-no\" title=\"branch not covered\" ></span>\n<span class=\"branch-1 cbranch-no\" title=\"branch not covered\" ></span>\n    return (<span class=\"branch-0 cbranch-no\" title=\"branch not covered\" ></span>\n      &lt;li key={node.path} role={ARIA_ATTRS.ROLE_NONE}&gt;\n        &lt;bu<span class=\"fstat-no\" title=\"function not covered\" >tt</span>on\n<span class=\"cstat-no\" title=\"statement not covered\" >          type={FORM_AT</span>TRS.TYPE_BUTTON}\n<span class=\"cstat-no\" title=\"statement not covered\" >          role={ARIA_ATTRS.R</span>OLE_TREEITEM}\n          className={`${DOCS_CLASSES.DOCS_TREE_ITEM}${open ? ` ${DOCS_CLASSES.DOCS_TREE_OPEN}` : CHAR_STRINGS.EMPTY}`}\n          aria-expanded={isDir ? <span class=\"branch-2 cbranch-no\" title=\"branch not covered\" >String(open) : undefin</span>ed}<span class=\"branch-0 cbranch-no\" title=\"branch not covered\" ></span>\n          aria-current={active ? 'page' : undefined}\n          {...{ [DATA_ATTRS.DATA_PATH]: node.path }}\n          Event) =&gt; {\n            e.preventDefault()\n&nbsp;\n            view.pickTreeNode(node)\n          }}\n        &gt;\n          {node.name}\n        &lt;/button&gt;\n        {isDir &amp;&amp; open &amp;&amp; node.children?.length ? (\n          &lt;ul role={ARIA_ATTRS.ROLE_GROUP}&gt;{treeNodes(view, node.children)}&lt;/ul&gt;\n        ) :<span class=\"fstat-no\" title=\"function not covered\" > n</span>ull}<span class=\"cstat-no\" title=\"statement not covered\" ></span>\n      &lt;/li&gt;\n    )\n  }) as HTMLEl