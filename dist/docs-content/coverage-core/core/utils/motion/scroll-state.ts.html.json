ass=\"cline-any cline-neutral\">&nbsp;</span>\n<span class=\"cline-any cline-neutral\">&nbsp;</span>\n<span class=\"cline-any cline-neutral\">&nbsp;</span>\n<span class=\"cline-any cline-neutral\">&nbsp;</span>\n<span class=\"cline-any cline-neutral\">&nbsp;</span></td><td class=\"text\"><pre class=\"prettyprint lang-js\">/**\n * @file scroll-state.js\n * @description Global \"is the window currently scrolling\" flag plus an\n * onScrollStop() one-shot registry — used to defer expensive work (layout\n * reads, lazy swaps, decoding) until a scroll gesture settles. Uses the\n * native scrollend event where available, else a SCROLL_SETTLE.QUIET_MS\n * debounce — the same quiet window the pooled observers hold for, so a\n * bursty throttled event stream can't flicker the flag mid-fling and let\n * deferred work land inside the gesture.\n */\nimport { WINDOW_EVENTS } from '@core/tokens/events/dom.js'\nimport { SCROLL_SETTLE } from '@core/tokens/motion/scroll.js'\nimport { TYPE_STRINGS } from '@core/tokens/strings/types.js'\n&nbsp;\nlet isWindowScrolling = false\n&nbsp;\n/**\n * Monotonic counter bumped on every scroll event — the decorative rAF\n * loops gate their repaint on \"no new scroll events for N frames\"\n * instead of reading window.scrollY per widget per frame: a live\n * scrollY read can force a scroll-offset query on a dirty layout,\n * and ~70 widgets doing it every frame was itself a frame-budget item.\n */\nlet scrollEventEpoch = 0\n&nbsp;\nlet scrollStopTimer: ReturnType&lt;typeof setTimeout&gt; | null = null\n&nbsp;\nconst scrollStopCallbacks = new Set&lt;() =&gt; void&gt;()\n&nbsp;\n/**\n * Subscribers notified on scroll ACTIVE/SETTLED transitions (not per\n * event) — the pooled-observer pause in observe.ts uses it to disconnect\n * IntersectionObservers for the duration of a fling so the engine\n * recomputes zero intersections while frames are scarce.\n */\nconst scrollStateListeners = new Set&lt;(active: boolean) =&gt; void&gt;()\n&nbsp;\n/**\n * Notifies every scroll-state listener; callbacks are isolated so a\n * throwing listener can't corrupt the scroll pipeline.\n * @param active — true when a gesture started, false when it settled\n */\nconst notifyScrollState = (active: boolean) =&gt; {\n  scrollStateListeners.forEach((cb) =&gt; {\n    try {\n      cb(active)\n    } catch {\n      // listener errors must not break the scroll pipeline\n    }\n  })\n}\n&nbsp;\n/** Fires when scrolling settles: clears the flag and drains pending callbacks. */\nconst handleScrollStop = () =&gt; {\n  const wasScrolling = isWindowScrolling\n&nbsp;\n  isWindowScrolling = false\n&nbsp;\n  if (wasScrolling) {\n    notifyScrollState(false)\n  }\n&nbsp;\n  if (scrollStopTimer) {\n    clearTimeout(scrollStopTimer)\n&nbsp;\n    scrollStopTimer = null\n  }\n&nbsp;\n  const callbacks = Array.from(scrollStopCallbacks)\n&nbsp;\n  scrollStopCallbacks.clear()\n&nbsp;\n  callbacks.forEach((cb) =&gt; {\n    try {\n      cb()\n    } catch {\n      // listener errors must not break the scroll pipeline\n    }\n  })\n}\n&nbsp;\n/** Marks scrolling as active and arms the quiet-window debounce fallback for scrollend. */\nconst handleScroll = () =&gt; {\n  if (!isWindowScrolling) {\n    isWindowScrolling = true\n&nbsp;\n    notifyScrollState(true)\n  }\n&nbsp;\n  scrollEventEpoch++\n&nbsp;\n  if (scrollStopTimer) {\n    clearTimeout(scrollStopTimer)\n  }\n&nbsp;\n  scrollStopTimer = setTimeout(handleScrollStop, SCROLL_SETTLE.QUIET_MS)\n}\n&nbsp;\nif (typeof window !== TYPE_STRINGS.UNDEFINED) {\n  window.addEventListener(WINDOW_EVENTS.SCROLL, handleScroll, { passive: true })\n&nbsp;\n  if ('onscrollend' in window) {\n    window.addEventListener(WINDOW_EVENTS.SCROLLEND, handleScrollStop, { passive: true })\n  }\n}\n&nbsp;\n/** True while a window scroll gesture is in progress. */\nexport const isScrolling = () =&gt; isWindowScrolling\n&nbsp;\n/**\n * Number of scroll events delivered so far — bumps once per event.\n * Consumers keep the last observed value; equality means no scroll\n * work has been dispatched since their previous frame.\n * @returns the scroll-event epoch counter.\n */\nexport const scrollEpoch = () =&gt; scrollEventEpoch\n&nbsp;\n/**\n * Queues a one-shot callback for the next scroll stop; fires immediately\n * when the window isn't scrolling right now.\n */\nexport const onScrollStop = (callback: () =&gt; void) =&gt; {\n  if (typeof callback !== TYPE_STRINGS.FUNCTION) return\n&nbsp;\n  if (!isWindowScrolling) {\n    callback()\n&nbsp;\n    return\n  }\n&nbsp;\n  scrollStopCallbacks.add(callback)\n}\n&nbsp;\n/**\n * Subscribes to scroll start/settle transitions — `cb(true)` fires once\n * when a gesture begins, `cb(false)` once when it settles (scrollend or\n * the debounce fallback). Unlike onScrollStop this is a persistent\n * subscription for machinery that must act at both edges.\n * @param cb — transition callback receiving the active flag\n */\nexport const onScrollStateChange = (cb: (active: boolean) =&gt; void) =&gt; {\n  if (typeof cb !== TYPE_STRINGS.FUNCTION) return\n&nbsp;\n  scrollStateListeners.add(cb)\n}\n&nbsp;</pre></td></tr></table></pre>\n\n                <div class='push'></div><!-- for sticky footer -->\n            </div><!-- /wrapper -->\n            <div class='footer quiet pad2 space-top1 center small'>\n                Code coverage generated by\n                <a href=\"https://istanbul.js.org/\" target=\"_blank\" rel=\"noopener noreferrer\">istanbul</a>\n                at 2026-10-15T07:07:06.190Z\n            </div>\n        \n        \n        \n        \n    </div>","mtime":"2026-10-15T07:07:06.393Z"}