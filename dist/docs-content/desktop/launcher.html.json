{"name":"launcher.html","path":"launcher.html","format":"html","html":"<div class=\"docs-html\"><style>\r\n      :root {\r\n        --bg: #0b0c10;\r\n        --panel: #15171d;\r\n        --text: #e0e6ed;\r\n        --muted: #8892b0;\r\n        --accent: #64f0c1;\r\n        --border: #2a2e38;\r\n        --radius: 0.75rem;\r\n        --gap: 1rem;\r\n      }\r\n\r\n      * {\r\n        box-sizing: border-box;\r\n      }\r\n\r\n      .docs-html {\r\n        margin: 0;\r\n        font-family:\r\n          system-ui,\r\n          -apple-system,\r\n          BlinkMacSystemFont,\r\n          'Segoe UI',\r\n          Roboto,\r\n          sans-serif;\r\n        background: var(--bg);\r\n        color: var(--text);\r\n        display: flex;\r\n        flex-direction: column;\r\n        height: 100vh;\r\n      }\r\n\r\n      header {\r\n        padding: var(--gap);\r\n        border-bottom: 1px solid var(--border);\r\n      }\r\n\r\n      h1 {\r\n        margin: 0;\r\n        font-size: 1.25rem;\r\n        font-weight: 600;\r\n      }\r\n\r\n      p {\r\n        margin: 0.35rem 0 0;\r\n        color: var(--muted);\r\n        font-size: 0.875rem;\r\n      }\r\n\r\n      .actions {\r\n        display: grid;\r\n        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));\r\n        gap: var(--gap);\r\n        padding: var(--gap);\r\n      }\r\n\r\n      button {\r\n        appearance: none;\r\n        border: 1px solid var(--border);\r\n        background: var(--panel);\r\n        color: var(--text);\r\n        padding: 0.75rem 1rem;\r\n        border-radius: var(--radius);\r\n        font-size: 0.95rem;\r\n        cursor: pointer;\r\n        transition:\r\n          border-color 0.2s,\r\n          transform 0.1s;\r\n      }\r\n\r\n      button:hover {\r\n        border-color: var(--accent);\r\n      }\r\n\r\n      button:active {\r\n        transform: translateY(1px);\r\n      }\r\n\r\n      button.primary {\r\n        border-color: var(--accent);\r\n        color: var(--accent);\r\n      }\r\n\r\n      .log {\r\n        flex: 1;\r\n        margin: 0 var(--gap) var(--gap);\r\n        padding: var(--gap);\r\n        background: var(--panel);\r\n        border: 1px solid var(--border);\r\n        border-radius: var(--radius);\r\n        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\r\n        font-size: 0.75rem;\r\n        line-height: 1.5;\r\n        overflow: auto;\r\n        white-space: pre-wrap;\r\n        word-break: break-word;\r\n      }\r\n    </style>\n\r\n    <header>\r\n      <h1>luiskr.com V3 — Project Launcher</h1>\r\n      <p>Run setup, dev server, verification, build, or the desktop preview.</p>\r\n    </header>\r\n\r\n    <div class=\"actions\">\r\n      <button class=\"primary\">1. Run setup</button>\r\n      <button>2. Run dev server</button>\r\n      <button>3. Run verify</button>\r\n      <button>4. Run build</button>\r\n      <button>5. Desktop preview</button>\r\n    </div>\r\n\r\n    <pre class=\"log\" id=\"log\">Waiting for a command...</pre>\r\n\r\n    \r\n  </div>","mtime":"2026-10-21T07:52:39.270Z"}