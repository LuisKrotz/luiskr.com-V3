{"name":"launcher.html","path":"launcher.html","format":"html","html":"<div class=\"docs-html\"><style>\n      :root {\n        --bg: #0b0c10;\n        --panel: #15171d;\n        --text: #e0e6ed;\n        --muted: #8892b0;\n        --accent: #64f0c1;\n        --border: #2a2e38;\n        --radius: 0.75rem;\n        --gap: 1rem;\n      }\n\n      * {\n        box-sizing: border-box;\n      }\n\n      .docs-html {\n        margin: 0;\n        font-family:\n          system-ui,\n          -apple-system,\n          BlinkMacSystemFont,\n          'Segoe UI',\n          Roboto,\n          sans-serif;\n        background: var(--bg);\n        color: var(--text);\n        display: flex;\n        flex-direction: column;\n        height: 100vh;\n      }\n\n      header {\n        padding: var(--gap);\n        border-bottom: 1px solid var(--border);\n      }\n\n      h1 {\n        margin: 0;\n        font-size: 1.25rem;\n        font-weight: 600;\n      }\n\n      p {\n        margin: 0.35rem 0 0;\n        color: var(--muted);\n        font-size: 0.875rem;\n      }\n\n      .actions {\n        display: grid;\n        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));\n        gap: var(--gap);\n        padding: var(--gap);\n      }\n\n      button {\n        appearance: none;\n        border: 1px solid var(--border);\n        background: var(--panel);\n        color: var(--text);\n        padding: 0.75rem 1rem;\n        border-radius: var(--radius);\n        font-size: 0.95rem;\n        cursor: pointer;\n        transition:\n          border-color 0.2s,\n          transform 0.1s;\n      }\n\n      button:hover {\n        border-color: var(--accent);\n      }\n\n      button:active {\n        transform: translateY(1px);\n      }\n\n      button.primary {\n        border-color: var(--accent);\n        color: var(--accent);\n      }\n\n      .log {\n        flex: 1;\n        margin: 0 var(--gap) var(--gap);\n        padding: var(--gap);\n        background: var(--panel);\n        border: 1px solid var(--border);\n        border-radius: var(--radius);\n        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n        font-size: 0.75rem;\n        line-height: 1.5;\n        overflow: auto;\n        white-space: pre-wrap;\n        word-break: break-word;\n      }\n    </style>\n\n    <header>\n      <h1>luiskr.com V3 — Project Launcher</h1>\n      <p>Run setup, dev server, verification, build, or the desktop preview.</p>\n    </header>\n\n    <div class=\"actions\">\n      <button class=\"primary\">1. Run setup</button>\n      <button>2. Run dev server</button>\n      <button>3. Run verify</button>\n      <button>4. Run build</button>\n      <button>5. Desktop preview</button>\n    </div>\n\n    <pre class=\"log\" id=\"log\">Waiting for a command...</pre>\n\n    \n  </div>","mtime":"2026-10-10T18:04:44.932Z"}