off&quot; dwell before the pen hops to the next char.\n    let edge = v.p * 1.04;\n    let write = 1.0 - smoothstep(edge - 0.012, edge, texel.r);\n\n    // Nib bead — a tight ridge straddling the frontier: coverage overfills\n    // ~0.8% of the span around the edge, ink darkens under pressure.\n    let nib_d = (texel.r - edge) / 0.008;\n    let nib = exp(-nib_d * nib_d);\n\n    let cov = min(write + nib * 0.25, 1.0);\n    let a = texel.a * u.ink.a * v.alpha * cov;\n    let rgb = u.ink.rgb * (1.0 - nib * 0.12);\n\n    return vec4&lt;f32&gt;(rgb * a, a);\n}\ninit: gpu slot poisonedattempted to take ownership of Rust value while it was borrowed\rcreate_view: �\u0000\tcontext: �\u0000\u001acreate_bind_group_layout: �\u0000\u000fcreate_buffer: �\u0000\u0010create_texture: �\u0000\u0018create_render_pipeline: �\u0000�\u0002: �\u0000/rustc/58cf8f9c35b355199727627d07ae34a4e2846d67/library/alloc/src/fmt.rs\u0000/home/luis/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/web-sys-0.3.106/src/features/gen_GpuTextureFormat.rs\u0000/rustc/58cf8f9c35b355199727627d07ae34a4e2846d67/library/std/src/sys/sync/rwlock/no_threads.rs\u0000/home/luis/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/js-sys-0.3.106/src/futures/jspi.rs\u0000/rustc/58cf8f9c35b355199727627d07ae34a4e2846d67/library/alloc/src/raw_vec/mod.rs\u0000/rust/deps/dlmalloc-0.2.14/src/dlmalloc.rs\u0000/home/luis/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/once_cell-1.21.4/src/lib.rs\u0000\bJsValue(�\u0001)\u0000gpuwebgpucontext: webgpu unavailablenavigatorinit_surface: no usable GPUDevicevs_mainfs_mainA!\u0010\u0000t\u0000\u0000\u0000\u0005\u0000\u0000\u0000\u0001\u0000\u0000\u0000internal error: entered unreachable code: The JS binding should only ever produce a valid value or the specific &#39;invalid&#39; valuereentrant init\u0000\u0000\u0000�&quot;\u0010\u0000[\u0000\u0000\u0000�\u0002\u0000\u0000\r\u0000\u0000\u0000closure invoked recursively or after being droppedLazy instance has previously been po