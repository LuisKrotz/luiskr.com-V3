{
  "openapi": "3.0.3",
  "info": {
    "title": "luiskr.com Public Content API",
    "description": "Read-only machine-readable surface of luiskr.com: documentation content, agent catalogs, sitemaps and linkset discovery. All endpoints are GET-only and require no authentication.",
    "version": "1.0.0",
    "contact": {
      "name": "Luis Krötz",
      "url": "https://luiskr.com/contact",
      "email": "luis.krotz@gmail.com"
    }
  },
  "servers": [{ "url": "https://luiskr.com" }],
  "paths": {
    "/docs-content/{filePath}": {
      "get": {
        "summary": "Documentation content JSON",
        "description": "Structured JSON export of a documentation/source file published by the docs portal (mirrored at /docs).",
        "operationId": "getDocsContent",
        "parameters": [
          {
            "name": "filePath",
            "in": "path",
            "required": true,
            "description": "Repository-relative path ending in .json (e.g. shared/docs/architecture/routing.md.json).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Documentation content payload.",
            "content": { "application/json": {} }
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "LLM-oriented site summary",
        "description": "Curated llms.txt index of the site's agent-relevant content.",
        "operationId": "getLlmsTxt",
        "responses": {
          "200": {
            "description": "llms.txt document.",
            "content": { "text/plain": {} }
          }
        }
      }
    },
    "/ai-catalog.json": {
      "get": {
        "summary": "AI content catalog",
        "description": "Agent-readable catalog of the site's featured content entries.",
        "operationId": "getAiCatalog",
        "responses": {
          "200": {
            "description": "AI catalog document.",
            "content": { "application/json": {} }
          }
        }
      }
    },
    "/.well-known/api-catalog": {
      "get": {
        "summary": "RFC 9727 API catalog",
        "description": "Linkset of the site's machine-readable API surface.",
        "operationId": "getApiCatalog",
        "responses": {
          "200": {
            "description": "Linkset API catalog.",
            "content": { "application/linkset+json": {} }
          }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "summary": "XML sitemap",
        "description": "English sitemap; per-locale sitemaps live at /sitemap-<locale>.xml.",
        "operationId": "getSitemap",
        "responses": {
          "200": {
            "description": "Sitemap XML document.",
            "content": { "application/xml": {} }
          }
        }
      }
    }
  }
}
